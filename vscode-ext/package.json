{
  "name": "pypipeline-visualizer",
  "displayName": "PyPipeline Visualizer",
  "description": "Visualize .pypipeline YAML files as horizontal tree diagrams",
  "version": "0.2.0",
  "publisher": "local",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Visualization"
  ],
  "activationEvents": [
    "onCommand:pipeline.open",
    "onCommand:pipeline.openActive"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "pipeline.open",
        "title": "Pipeline: Open Pipeline File..."
      },
      {
        "command": "pipeline.openActive",
        "title": "Pipeline: Open Pipeline View"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "when": "resourceExtname == .pypipeline",
          "command": "pipeline.openActive",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "when": "resourceExtname == .pypipeline",
          "command": "pipeline.openActive",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.19.37",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^2.22.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  }
}
